# Production-build defaults (loaded by Vite for `vinxi build`, including on Vercel).
# Vercel Project Environment Variables override anything set here.
#
# VITE_ values are inlined at build time, so changing any of them needs a redeploy.
VITE_API_BASE=https://api.edu.aajneeti.social/api/v1
VITE_USE_MOCK=false
VITE_SITE_NAME=ACL Education Portal
# Canonical/OG URLs are built from this. It must be the public production origin:
# pointing it at a *.vercel.app deployment URL makes every canonical point off
# this domain, which is enough on its own to keep the site out of the index.
VITE_SITE_ORIGIN=https://edu.aajneeti.social
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
